
<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="BTLWeb.SiteMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Website Thi Trắc Nghiệm</title>

    <link href="CSS/Site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">

        <header class="header">
            <div class="header-container">
                <div class="logo">
                    <a href="TrangChu.aspx">QUIZ ONLINE</a>
                </div>

                <nav class="menu">
                    <a href="TrangChu.aspx">Trang chủ</a>

                    <a href="DanhSachDeThi.aspx">Đề thi</a>

                    <asp:PlaceHolder ID="phQuanLy" runat="server"
                        Visible="false">

                        <a href="QuanLyDeThi.aspx">Quản lý đề thi</a>

                        <a href="QuanLyCauHoi.aspx">Quản lý câu hỏi</a>

                    </asp:PlaceHolder>
                </nav>

                <div class="account-area">

                    <asp:PlaceHolder ID="phChuaDangNhap"
                        runat="server">

                        <a href="DangNhap.aspx" class="account-link">
                            Đăng nhập
                        </a>

                        <a href="DangKy.aspx" class="register-link">
                            Đăng ký
                        </a>

                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phDaDangNhap"
                        runat="server" Visible="false">

                        <a href="TaiKhoan.aspx">
                            Xin chào,
                            <asp:Label ID="lblTenNguoiDung"
                                runat="server" />
                        </a>

                        <asp:LinkButton ID="btnDangXuat"
                            runat="server"
                            CssClass="account-link"
                            OnClick="btnDangXuat_Click"
                            CausesValidation="false">
                            Đăng xuất
                        </asp:LinkButton>

                    </asp:PlaceHolder>

                </div>
            </div>
        </header>

        <main class="main-container">
            <asp:ContentPlaceHolder ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>
        </main>

        
<footer class="site-footer">

    <div class="footer-container">

        <!-- CỘT 1: GIỚI THIỆU -->
        <div class="footer-column footer-about">
            <h2>QUIZ ONLINE</h2>

            <p>
                Hệ thống thi trắc nghiệm trực tuyến giúp
                người học ôn tập, luyện tập và kiểm tra
                kiến thức một cách nhanh chóng, hiệu quả.
            </p>

            <p class="footer-slogan">
                Học tập mọi lúc - Kiểm tra mọi nơi.
            </p>
        </div>

        <!-- CỘT 2: LIÊN KẾT NHANH -->
        <div class="footer-column">
            <h3>Liên kết nhanh</h3>

            <ul>
                <li><a href="TrangChu.aspx">Trang chủ</a></li>
                <li><a href="DanhSachDeThi.aspx">Kho đề thi</a></li>
                <li><a href="DangNhap.aspx">Đăng nhập</a></li>
                <li><a href="DangKy.aspx">Đăng ký tài khoản</a></li>
                <li><a href="LichSuThi.aspx">Lịch sử thi</a></li>
            </ul>
        </div>

        <!-- CỘT 3: HƯỚNG DẪN -->
        <div class="footer-column">
            <h3>Hướng dẫn sử dụng</h3>

            <ul>
                <li><a href="DangKy.aspx">Tạo tài khoản</a></li>
                <li><a href="DanhSachDeThi.aspx">Chọn đề thi</a></li>
                <li><a href="DanhSachDeThi.aspx">Tham gia làm bài</a></li>
                <li><a href="LichSuThi.aspx">Theo dõi kết quả</a></li>
            </ul>
        </div>

        <!-- CỘT 4: THÔNG TIN -->
        <div class="footer-column">
            <h3>Thông tin hệ thống</h3>

            <ul>
                <li>📚 Nền tảng học tập trực tuyến</li>
                <li>📝 Thi trắc nghiệm trực tuyến</li>
                <li>⏱️ Theo dõi thời gian làm bài</li>
                <li>📊 Xem kết quả sau khi thi</li>
            </ul>
        </div>

    </div>

    <!-- BẢN QUYỀN -->
    <div class="footer-bottom">
        <p>
            © 2026 QUIZ ONLINE. All rights reserved.
        </p>

        <p>
            Website thi trắc nghiệm trực tuyến
        </p>
    </div>

</footer>


    </form>
</body>
</html>
